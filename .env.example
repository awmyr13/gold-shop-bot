# Copy this file to `.env` and fill in your own values. Never commit `.env`.

# --- Required ---------------------------------------------------------------
# Token from Bale's BotFather
BOT_TOKEN=
# Numeric Bale user ids of the admins, comma-separated
ADMIN_IDS=111111111,222222222

# --- Gold price sources (all optional; see README "How the price is resolved") ---
# Channel whose posts contain a line like "طلای ۱۸ عیار: ۱۸,۵۰۰,۰۰۰"
GOLD_PRICE_CHANNEL=@your_price_channel
# JSON endpoint returning the price of 1g of 18k gold, and the key that holds it
PRICE_API_URL=
PRICE_API_FIELD=YekGram18

# --- Shop details (shown in messages and in the product post template) ------
SHOP_NAME=My Gold Shop
SHOP_PHONE=
SHOP_LANDLINE=
SHOP_ADDRESS=
SHOP_SHIPPING_NOTE=
SHOP_NOTE=
SHOP_CONTACT_HANDLE=
SHOP_ETAA_URL=
SHOP_CHANNEL=

# --- Misc -------------------------------------------------------------------
# Number given to the first product (later posts count up from here)
PRODUCT_NUM_START=1
# Where the SQLite database and logs are stored (default: ./data, or /app/backups in Docker)
# DATA_DIR=./data
